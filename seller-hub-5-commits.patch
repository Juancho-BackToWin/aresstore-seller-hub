+  const avisoIva = document.getElementById('dataTaxWarn');
+  if(avisoIva){
+    const S = salesRows({from:null, country:'ALL'});
+    const sinCol = S.filter(r=>!r.taxSeen), rev = S.reduce((a,r)=>a+r.revenue,0);
+    const revSin = sinCol.reduce((a,r)=>a+r.revenue,0);
